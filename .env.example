# انسخ القيم دي في Vercel → Project → Settings → Environment Variables
# (متحطّهاش في الكود ولا ترفعها على GitHub)

# ===== WhatsApp (api/send.js) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+201043237379
TWILIO_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Email (api/send-mail.js) =====
# المواقع المسموح لها تنادي الـ API (origins) — افصل بينها بفاصلة
ALLOWED_ORIGINS=https://vowlyeg.com,https://www.vowlyeg.com

# حساب الـ SMTP اللي بيبعت (نفسه لكل المواقع)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@vowlyeg.com
SMTP_PASS=your_mailbox_password
SMTP_FROM=Vowly <admin@vowlyeg.com>

# المستقبِل الافتراضي (ممكن يتجاهله الـ token المشفّر لو الموقع بعت credentials)
SMTP_TO=admin@vowlyeg.com

# مفتاح فك التشفير للـ credentials token (base64 لـ 32 بايت) — لازم يطابق مفتاح الموقع
MAIL_ENCRYPTION_KEY=base64_32_byte_key_here
